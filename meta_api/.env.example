# Copy to meta_api/.env (git-ignored) and fill in. Never commit the real file.

# System User access token from Business Manager (Speak, business id 1228002260697334).
# Needs the ads_read scope (plus ads_management only if you ever write to Meta — the
# routines in this repo never do). Generate it as a non-expiring System User token.
META_ACCESS_TOKEN=

# Ad account WITHOUT the act_ prefix. Speak ZH = 1148917790153640.
META_AD_ACCOUNT_ID=1148917790153640

# App id / secret are only needed for appsecret_proof (recommended) and for
# exchanging short-lived user tokens for long-lived ones. Leave blank to skip.
META_APP_ID=
META_APP_SECRET=

# Graph API version. Bump deliberately — Meta retires versions ~2 years after release.
META_API_VERSION=v21.0
